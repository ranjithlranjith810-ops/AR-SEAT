# Copy to .env and fill in your own credentials.
# Development database (transaction-mode pooler)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct / session-mode pooler used for Prisma migrations
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Isolated test database (created by scripts/setup-test-db.mjs)
# Session-mode pooler connection: avoids pgbouncer single-query overhead for tests.
TEST_DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@<REGION>.pooler.supabase.com:5432/exam_seating_test?sslmode=require"
TEST_DIRECT_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@<REGION>.pooler.supabase.com:5432/exam_seating_test?sslmode=require"

# Supabase project
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_ANON_KEY="<publishable or anon key>"
# REQUIRED for live PDF uploads into the private bucket.
# Dashboard > Project Settings > API keys > service_role secret ("sb_secret_...").
SUPABASE_SERVICE_ROLE_KEY=""

# Private storage bucket for exam PDFs (created by scripts/ensure-storage-bucket.mjs)
SUPABASE_STORAGE_BUCKET="exam-documents"

# Real Supabase Storage integration tests are an EXPLICIT opt-in provided only at
# run time (CLI/CI), e.g. STORAGE_INTEGRATION=1 npm test. Never set this to "1" in
# .env — a normal `npm test` must not access the live bucket. When
# STORAGE_INTEGRATION=1 is requested but the Supabase configuration above is
# incomplete, the integration suite FAILS clearly instead of skipping.
STORAGE_INTEGRATION=""