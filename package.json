{
  "name": "ar-seat-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Exam Seating Arrangement Prototype - Database Foundation (Step 1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^16.4.5",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "prisma": "^6.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
